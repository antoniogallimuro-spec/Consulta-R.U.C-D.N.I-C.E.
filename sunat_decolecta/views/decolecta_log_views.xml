<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sunat_decolecta_log_tree" model="ir.ui.view">
        <field name="name">sunat.decolecta.log.tree</field>
        <field name="model">sunat.decolecta.log</field>
        <field name="arch" type="xml">
            <list string="Consumo de Decolecta" create="0" edit="0" delete="0">
                <field name="request_datetime"/>
                <field name="endpoint_key"/>
                <field name="document_type"/>
                <field name="document_number"/>
                <field name="partner_id"/>
                <field name="status_code"/>
                <field name="success"/>
                <field name="duration_ms"/>
                <field name="user_id"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sunat_decolecta_log_form" model="ir.ui.view">
        <field name="name">sunat.decolecta.log.form</field>
        <field name="model">sunat.decolecta.log</field>
        <field name="arch" type="xml">
            <form string="Consulta a Decolecta" create="0" edit="0" delete="0">
                <group>
                    <group>
                        <field name="request_datetime"/>
                        <field name="endpoint_key"/>
                        <field name="document_type"/>
                        <field name="document_number"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="status_code"/>
                        <field name="success"/>
                        <field name="duration_ms"/>
                        <field name="user_id"/>
                        <field name="company_id"/>
                    </group>
                </group>
                <group string="Error" invisible="not error_message">
                    <field name="error_message" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_sunat_decolecta_log_pivot" model="ir.ui.view">
        <field name="name">sunat.decolecta.log.pivot</field>
        <field name="model">sunat.decolecta.log</field>
        <field name="arch" type="xml">
            <pivot string="Consumo de Decolecta" sample="1">
                <field name="month" type="col"/>
                <field name="endpoint_key" type="row"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sunat_decolecta_log_graph" model="ir.ui.view">
        <field name="name">sunat.decolecta.log.graph</field>
        <field name="model">sunat.decolecta.log</field>
        <field name="arch" type="xml">
            <graph string="Consumo de Decolecta" type="bar" sample="1">
                <field name="month"/>
                <field name="endpoint_key"/>
            </graph>
        </field>
    </record>

    <record id="view_sunat_decolecta_log_search" model="ir.ui.view">
        <field name="name">sunat.decolecta.log.search</field>
        <field name="model">sunat.decolecta.log</field>
        <field name="arch" type="xml">
            <search string="Consumo de Decolecta">
                <field name="endpoint_key"/>
                <field name="document_number"/>
                <field name="partner_id"/>
                <filter name="filter_failed" string="Con error"
                        domain="[('success', '=', False)]"/>
                <separator/>
                <filter name="filter_this_month" string="Este mes"
                        domain="[('month', '=', context_today().strftime('%Y-%m'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_month" string="Mes"
                            context="{'group_by': 'month'}"/>
                    <filter name="group_endpoint" string="Servicio"
                            context="{'group_by': 'endpoint_key'}"/>
                    <filter name="group_user" string="Usuario"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sunat_decolecta_log" model="ir.actions.act_window">
        <field name="name">Consumo de Decolecta</field>
        <field name="res_model">sunat.decolecta.log</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_sunat_decolecta_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay consultas registradas</p>
            <p>Cada consulta a la API de Decolecta (RUC, DNI, tipo de cambio, AFP)
               queda registrada aquí con su fecha, documento enmascarado y resultado.</p>
        </field>
    </record>

    <menuitem id="menu_sunat_decolecta_root"
              name="SUNAT / Decolecta"
              parent="base.menu_custom"
              groups="base.group_system"
              sequence="90"/>
    <menuitem id="menu_sunat_decolecta_log"
              name="Consumo de la API"
              parent="menu_sunat_decolecta_root"
              action="action_sunat_decolecta_log"
              sequence="10"/>

</odoo>
