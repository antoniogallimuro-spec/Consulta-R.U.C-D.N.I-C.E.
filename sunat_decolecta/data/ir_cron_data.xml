<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_sunat_decolecta_rate" model="ir.cron">
            <field name="name">SUNAT Decolecta: tipo de cambio diario</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model._cron_sunat_decolecta_rate()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_sunat_decolecta_afp" model="ir.cron">
            <field name="name">SUNAT Decolecta: comisiones AFP del mes</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model._cron_sunat_decolecta_afp()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">6</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
